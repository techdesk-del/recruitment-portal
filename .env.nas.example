# =================================================================
# Synology DS925+ Deployment Environment Configuration
# =================================================================

# Dashboard Access Port on your Synology NAS (e.g. http://<nas-ip>:3080)
PORT=3080
BACKEND_PORT=5050
MONGO_PORT=27018
REDIS_PORT=6380

# Synology NAS Shared Folder Storage Path for Persistent Data
# Default DSM path: /volume1/docker/recruitment-dashboard/nas-data
DATA_ROOT=./nas-data

# -------------------------------------------------------------
# Database Architecture Options:
# -------------------------------------------------------------
# Option 1: Full On-Premise (Fastest LAN performance, 100% offline survivable)
MONGODB_URI=mongodb://mongo:27017/recruitment_dashboard

# Option 2: Direct MongoDB Atlas Cloud Connection (Synchronizes with Cloud)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mflxz4m.mongodb.net/recruitment_dashboard?retryWrites=true&w=majority

# Option 3: Dual Real-Time Replication (Local NAS MongoDB + MongoDB Atlas)
# Leave MONGODB_URI pointing to local mongo and set CLOUD_MONGODB_URI to Atlas:
# CLOUD_MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mflxz4m.mongodb.net/recruitment_dashboard?retryWrites=true&w=majority

# Redis Queue & Cache Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=urbangaon_enterprise_synology_production_jwt_key_2026
JWT_EXPIRES_IN=7d

# LinkedIn Email Auto-Ingestion (IMAP)
LINKEDIN_SYNC_EMAIL=
LINKEDIN_SYNC_PASSWORD=
LINKEDIN_IMAP_HOST=imap.gmail.com
LINKEDIN_IMAP_PORT=993

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=UrbanGaon Careers <careers@urbangaon.com>
COMPANY_NAME=UrbanGaon
COMPANY_WEBSITE=https://urbangaon.com

